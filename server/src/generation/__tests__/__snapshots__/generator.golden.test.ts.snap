import { Router } from 'express';
import { protect } from '../middleware/auth.middleware';
import { requireRole } from '../middleware/rbac.middleware';
import { validate } from '../middleware/validate.middleware';
import * as ctrl from '../controllers/application.controller';
import { createApplicationRules, updateApplicationRules } from '../validators/application.validator';
const router = Router();
router.use(protect);
// Permission matrix (from the WorkflowSpec — see config/roles.ts):
//   admission_officer: Register Applications, Schedule Tests, Record Decisions, View Student Records
//   teacher: View Student Records, Record Test Scores
//   principal: View Student Records, Approve Admissions, View Reports, Manage Fees
//   accounts_staff: Manage Fees, Collect Payments, View Student Records
// Write access (create/update/delete) restricted to: admission_officer.
router.get('/', ctrl.list);
router.get('/:id', ctrl.get);
router.post('/', requireRole('admission_officer'), createApplicationRules, validate, ctrl.create);
router.put('/:id', requireRole('admission_officer'), updateApplicationRules, validate, ctrl.update);
router.delete('/:id', requireRole('admission_officer'), ctrl.remove);
router.post('/:id/transition', ctrl.transition);
export default router;
