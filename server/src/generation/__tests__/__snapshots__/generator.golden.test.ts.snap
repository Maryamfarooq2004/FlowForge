    "contents": "/* Auto-generated by FlowForge — brand theme (clinic). */
:root {
  --color-primary: #1D4ED8;
  --color-secondary: #1E3A8A;
  --color-accent: #38BDF8;
  --font-heading: 'Poppins', system-ui, sans-serif;
  --font-body: 'Inter', system-ui, sans-serif;
  --bg: #f8fafc;
  --surface: #ffffff;
  --border: #e2e8f0;
  --text: #0f172a;
  --muted: #64748b;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: var(--font-body); color: var(--text); background: var(--bg); }
h1, h2, h3 { font-family: var(--font-heading); margin: 0 0 0.5rem; }
a { color: var(--color-primary); text-decoration: none; }
.muted { color: var(--muted); }
/* Layout */
.app-shell { display: flex; min-height: 100vh; }
.sidebar { width: 230px; background: var(--surface); border-right: 1px solid var(--border); padding: 1rem; }
.sidebar-brand { font-family: var(--font-heading); font-weight: 700; color: var(--color-primary); padding: 0.5rem; margin-bottom: 1rem; }
.sidebar-nav { display: flex; flex-direction: column; gap: 0.25rem; }
.nav-item { padding: 0.5rem 0.75rem; border-radius: 8px; color: var(--muted); font-weight: 500; }
.nav-item:hover { background: #f1f5f9; color: var(--text); }
.nav-item.active { background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary); }
.main-area { flex: 1; display: flex; flex-direction: column; }
.topbar { height: 56px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: flex-end; padding: 0 1.5rem; }
.topbar-user { display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; }
.role-chip { background: color-mix(in srgb, var(--color-secondary) 15%, transparent); color: var(--color-secondary); border-radius: 999px; padding: 2px 10px; font-size: 0.72rem; font-weight: 700; text-transform: capitalize; }
.content { padding: 2rem; }
/* Components */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.25rem; }
.btn { border: 0; border-radius: 8px; padding: 0.5rem 1rem; font-weight: 600; cursor: pointer; font-size: 0.9rem; }
.btn-primary { background: var(--color-primary); color: #fff; }
.btn-primary:disabled { opacity: 0.6; cursor: default; }
.btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
.btn-sm { padding: 0.3rem 0.6rem; font-size: 0.8rem; }
.badge { display: inline-block; background: color-mix(in srgb, var(--color-accent) 22%, transparent); color: var(--text); border-radius: 999px; padding: 2px 10px; font-size: 0.72rem; font-weight: 700; }
.field { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.9rem; }
.field > span { font-size: 0.8rem; font-weight: 600; color: var(--muted); }
.input, .select, textarea.input { width: 100%; padding: 0.55rem 0.7rem; border: 1px solid var(--border); border-radius: 8px; font: inherit; background: #fff; }
.input:focus, .select:focus { outline: none; border-color: var(--color-primary); }
.table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
.table th { text-align: left; background: var(--color-primary); color: #fff; padding: 0.7rem 1rem; font-size: 0.82rem; }
.table td { padding: 0.7rem 1rem; border-top: 1px solid var(--border); font-size: 0.88rem; }
.table tr:hover td { background: #f8fafc; }
.row-between { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; gap: 1rem; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
.stat-value { font-size: 2rem; font-weight: 700; font-family: var(--font-heading); }
.alert-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 8px; padding: 0.6rem 0.8rem; margin-bottom: 0.8rem; font-size: 0.85rem; }
.auth-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--bg); }
.auth-card { width: 360px; }
.brand-title { color: var(--color-primary); }
.link-btn { background: none; border: 0; color: var(--color-primary); cursor: pointer; font: inherit; padding: 0; }
