    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand — regenerate from the
 * approved WorkflowSpec instead.
 * Data access & business logic for Appointment.
 */
import { Appointment } from '../models/Appointment.model';
import { AppError } from '../utils/AppError';
import { TRANSITIONS, STATE_KEYS } from '../config/workflow';
import { notify } from './notification.service';
// ── Business rules (from the WorkflowSpec) ──
// [FlowForge RULE — enforced via transition role guards]: Only Doctors can view or edit clinical diagnoses.
const WRITABLE = ['patientId', 'date', 'time', 'type', 'notes'] as const;
const pick = (data: Record<string, any>): Record<string, any> => {
  const out: Record<string, any> = {};
  for (const key of WRITABLE) {
    if (data[key] !== undefined) out[key] = data[key];
  }
  return out;
};
export interface ListOptions { page?: number; limit?: number; sort?: string; order?: string; }
// Sortable columns are allow-listed: an unvalidated sort column would be
// interpolated straight into ORDER BY.
const SORTABLE: string[] = ['id', 'patientId', 'date', 'time', 'type', 'status', 'notes'];
export const listAppointment = async (opts: ListOptions = {}) => {
  const page = Math.max(1, Number(opts.page) || 1);
  const limit = Math.min(100, Math.max(1, Number(opts.limit) || 25));
  const sort = SORTABLE.includes(String(opts.sort)) ? String(opts.sort) : 'id';
  const order = String(opts.order).toUpperCase() === 'ASC' ? 'ASC' : 'DESC';
  const { rows, count } = await Appointment.findAndCountAll({
    order: [[sort, order]] as any,
    limit,
    offset: (page - 1) * limit,
  });
  return {
    rows,
    pagination: { page, limit, total: count, totalPages: Math.max(1, Math.ceil(count / limit)) },
  };
};
export const getAppointment = async (id: number) => {
  const record = await Appointment.findByPk(id);
  if (!record) throw new AppError('Appointment not found.', 404, 'NOT_FOUND');
  return record;
};
export const createAppointment = async (data: Record<string, any>) =>
  Appointment.create(pick(data));
export const updateAppointment = async (id: number, data: Record<string, any>) => {
  const record = await getAppointment(id);
  await record.update(pick(data));
  return record;
};
export const deleteAppointment = async (id: number) => {
  const record = await getAppointment(id);
  await record.destroy();
};
export const transitionAppointment = async (
  id: number,
  to: string,
  user: { id: number; role: string }
) => {
  if (!STATE_KEYS.includes(to)) {
    throw new AppError('Unknown target state.', 422, 'VALIDATION_ERROR');
  }
  const record = await Appointment.findByPk(id);
  if (!record) throw new AppError('Appointment not found.', 404, 'NOT_FOUND');
  const current = String((record as any).status);
  const t = TRANSITIONS.find((x) => x.from === current && x.to === to);
  if (!t) {
    const allowed = TRANSITIONS.filter((x) => x.from === current).map((x) => x.label).join(', ') || 'none';
    throw new AppError(\`Cannot move from '\${current}' to '\${to}'. Allowed: \${allowed}.\`, 409, 'INVALID_TRANSITION');
  }
  // Transitions with a role are restricted to it; unroled transitions are
  // allowed for any authenticated user (no role was specified in the spec).
  if (t.roleKey && user.role !== t.roleKey) {
    throw new AppError(\`Only the '\${t.roleKey}' role can perform this action.\`, 403, 'FORBIDDEN');
  }
  if (to === 'cancelled') {
    // [FlowForge RULE] Appointments must be cancelled at least 24 hours in advance to avoid a no-show fee.
    const _scheduledMs = new Date(String((record as any).date)).getTime();
    if (!Number.isNaN(_scheduledMs) && _scheduledMs - Date.now() < 86400000) {
      throw new AppError('This must be done at least 24 hours in advance.', 400, 'RULE_VIOLATION');
    }
  }
  (record as any).status = to;
  await record.save();
  // Record an in-app notification (configured alerts live in config/notifications.ts).
  await notify({
    event: 'status_changed',
    entityType: 'appointment',
    entityId: (record as any).id,
    message: \`Appointment #\${id} moved to '\${to}'.\`,
  });
  return record;
};
",
