  {
    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand.
 * List screen for Enrollment.
 */
import { useEffect, useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import DataTable from '../../components/DataTable';
import type { Column } from '../../components/DataTable';
import StateBadge from '../../components/StateBadge';
import { api } from '../../api/client';
import { getEntity } from '../../lib/meta';
import { formatValue } from '../../lib/format';
const ENTITY = getEntity('enrollments')!;
export default function EnrollmentListPage() {
  const navigate = useNavigate();
  const [rows, setRows] = useState<Record<string, any>[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [page, setPage] = useState(1);
  const [totalPages, setTotalPages] = useState(1);
  const [total, setTotal] = useState(0);
  const load = () => {
    api
      .get<Record<string, any>>('/enrollments?page=' + String(page) + '&limit=25')
      .then((data) => {
        setRows((data[ENTITY.collectionKey] as Record<string, any>[]) || []);
        const p = data.pagination as Record<string, any> | undefined;
        setTotalPages(p ? Number(p.totalPages) : 1);
        setTotal(p ? Number(p.total) : 0);
      })
      .catch((err) => setError(err instanceof Error ? err.message : 'Failed to load'));
  };
  useEffect(load, [page]);
  const remove = async (id: unknown) => {
    if (!window.confirm('Delete this record?')) return;
    await api.del('/enrollments/' + String(id));
    load();
  };
  const baseCols: Column[] = ENTITY.fields
    .filter((f) => !f.isStatus)
    .slice(0, 4)
    .map((f) => ({ key: f.attrName, label: f.label }));
  const columns: Column[] = ENTITY.isWorkflow ? [...baseCols, { key: '__status', label: 'Status' }] : baseCols;
  return (
    <div>
      <div className="row-between">
        <h1>{ENTITY.label}</h1>
        <Link className="btn btn-primary" to="/enrollments/new">New {ENTITY.modelName}</Link>
      </div>
      {error ? <div className="alert-error">{error}</div> : null}
      <DataTable
        columns={columns}
        rows={rows}
        renderCell={(row, col) => {
          if (col.key === '__status') return <StateBadge label={String(row.status)} />;
          const field = ENTITY.fields.find((f) => f.attrName === col.key);
          return field ? formatValue(field, row[col.key]) : String(row[col.key] ?? '');
        }}
        actions={(row) => (
          <span style={{ display: 'flex', gap: '0.4rem' }}>
            <button className="btn btn-ghost btn-sm" onClick={() => navigate('/enrollments/' + String(row.id))}>View</button>
            <button className="btn btn-ghost btn-sm" onClick={() => navigate('/enrollments/' + String(row.id) + '/edit')}>Edit</button>
            <button className="btn btn-ghost btn-sm" onClick={() => remove(row.id)}>Delete</button>
          </span>
        )}
      />
      <div className="row-between" style={{ marginTop: '1rem' }}>
        <span className="muted">{total} record{total === 1 ? '' : 's'} · page {page} of {totalPages}</span>
        <span style={{ display: 'flex', gap: '0.4rem' }}>
          <button className="btn btn-ghost btn-sm" disabled={page <= 1} onClick={() => setPage(page - 1)}>Previous</button>
          <button className="btn btn-ghost btn-sm" disabled={page >= totalPages} onClick={() => setPage(page + 1)}>Next</button>
        </span>
      </div>
    </div>
  );
}
