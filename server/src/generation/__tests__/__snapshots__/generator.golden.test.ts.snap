    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand.
 * Create/edit form for Appointment.
 */
import { useEffect, useState } from 'react';
import type { FormEvent } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { api } from '../../api/client';
import { getEntity } from '../../lib/meta';
import type { FieldMeta } from '../../lib/meta';
const ENTITY = getEntity('appointments')!;
const EDITABLE = ENTITY.fields.filter((f) => !f.isStatus);
export default function AppointmentFormPage() {
  const navigate = useNavigate();
  const params = useParams();
  const id = params.id;
  const isEdit = Boolean(id);
  const [values, setValues] = useState<Record<string, any>>({});
  const [refs, setRefs] = useState<Record<string, Record<string, any>[]>>({});
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);
  useEffect(() => {
    for (const f of EDITABLE) {
      if (f.ref) {
        const attr = f.attrName;
        api
          .get<Record<string, any>>('/' + f.ref.targetRouteBase)
          .then((data) => {
            const list = Object.values(data)[0] as Record<string, any>[];
            setRefs((prev) => ({ ...prev, [attr]: Array.isArray(list) ? list : [] }));
          })
          .catch(() => undefined);
      }
    }
    if (id) {
      api
        .get<Record<string, any>>('/appointments/' + id)
        .then((data) => setValues((Object.values(data)[0] as Record<string, any>) || {}))
        .catch((err) => setError(err instanceof Error ? err.message : 'Failed to load'));
    }
  }, [id]);
  const set = (attr: string, value: any) => setValues((prev) => ({ ...prev, [attr]: value }));
  const onSubmit = async (ev: FormEvent<HTMLFormElement>) => {
    ev.preventDefault();
    setBusy(true);
    setError(null);
    try {
      if (isEdit) await api.put('/appointments/' + id, values);
      else await api.post('/appointments', values);
      navigate('/appointments');
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Save failed');
    } finally {
      setBusy(false);
    }
  };
  const control = (f: FieldMeta) => {
    const v = values[f.attrName];
    if (f.fieldType === 'boolean') {
      return <input type="checkbox" checked={Boolean(v)} onChange={(ev) => set(f.attrName, ev.target.checked)} />;
    }
    if (f.fieldType === 'enum' && f.enumValues) {
      return (
        <select className="select" value={v ?? ''} onChange={(ev) => set(f.attrName, ev.target.value)}>
          <option value="">Select\\u2026</option>
          {f.enumValues.map((o) => (
            <option key={o} value={o}>{o}</option>
          ))}
        </select>
      );
    }
    if (f.ref) {
      const opts = refs[f.attrName] || [];
      const displayAttr = f.ref.displayAttr;
      return (
        <select className="select" value={v ?? ''} onChange={(ev) => set(f.attrName, ev.target.value)}>
          <option value="">Select {f.ref.targetLabel}\\u2026</option>
          {opts.map((o) => (
            <option key={String(o.id)} value={String(o.id)}>{String(o[displayAttr] ?? o.id)}</option>
          ))}
        </select>
      );
    }
    if (f.fieldType === 'richtext') {
      return <textarea className="input" value={v ?? ''} onChange={(ev) => set(f.attrName, ev.target.value)} />;
    }
    const inputType =
      f.fieldType === 'number' || f.fieldType === 'currency' ? 'number'
        : f.fieldType === 'date' ? 'date'
        : f.fieldType === 'time' ? 'time'
        : f.fieldType === 'email' ? 'email'
        : f.fieldType === 'phone' ? 'tel'
        : 'text';
    return <input className="input" type={inputType} value={v ?? ''} onChange={(ev) => set(f.attrName, ev.target.value)} />;
  };
  return (
    <div style={{ maxWidth: 640 }}>
      <h1>{isEdit ? 'Edit' : 'New'} {ENTITY.modelName}</h1>
      {error ? <div className="alert-error">{error}</div> : null}
      <form className="card" onSubmit={onSubmit}>
        {EDITABLE.map((f) => (
          <label key={f.attrName} className="field">
            <span>{f.label}{f.required ? ' *' : ''}</span>
            {control(f)}
          </label>
        ))}
        <div style={{ display: 'flex', gap: '0.6rem', marginTop: '0.5rem' }}>
          <button type="button" className="btn btn-ghost" onClick={() => navigate('/appointments')}>Cancel</button>
          <button type="submit" className="btn btn-primary" disabled={busy}>{busy ? 'Saving\\u2026' : 'Save'}</button>
        </div>
      </form>
    </div>
  );
}
