    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand — regenerate from the
 * approved WorkflowSpec instead.
 * Routes for Appointment (mounted at /api/appointments).
 */
import { Router } from 'express';
import { protect } from '../middleware/auth.middleware';
import { requireRole } from '../middleware/rbac.middleware';
import { validate } from '../middleware/validate.middleware';
import * as ctrl from '../controllers/appointment.controller';
import { createAppointmentRules, updateAppointmentRules } from '../validators/appointment.validator';
const router = Router();
router.use(protect);
// Permission matrix (from the WorkflowSpec — see config/roles.ts):
//   receptionist: Register Patients, Book Appointments, View Patient Records, Manage Payments
//   doctor: View Patient Records, Edit Diagnosis, Write Prescriptions, View Reports
//   manager: View Patient Records, Manage Payments, Manage Staff, View Reports
// Write access (create/update/delete) restricted to: receptionist.
router.get('/', ctrl.list);
router.get('/:id', ctrl.get);
router.post('/', requireRole('receptionist'), createAppointmentRules, validate, ctrl.create);
router.put('/:id', requireRole('receptionist'), updateAppointmentRules, validate, ctrl.update);
router.delete('/:id', requireRole('receptionist'), ctrl.remove);
router.post('/:id/transition', ctrl.transition);
export default router;
",
