            <span>{user ? user.fullName || user.email : 'User'}</span>
            {user ? <span className="role-chip">{user.role}</span> : null}
            <button className="btn btn-ghost btn-sm" onClick={logout}>Logout</button>
          </div>
        </header>
        <main className="content">
          <Outlet />
        </main>
      </div>
    </div>
  );
}
