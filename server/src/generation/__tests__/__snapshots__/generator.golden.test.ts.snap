    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand — regenerate from the
 * approved WorkflowSpec instead.
 * Model registry & associations (wired after all models are constructed).
 */
import { sequelize } from '../config/database';
import { User } from './User.model';
import { Notification } from './Notification.model';
import { Student } from './Student.model';
import { Application } from './Application.model';
import { Enrollment } from './Enrollment.model';
import { FeePlan } from './FeePlan.model';
import { Payment } from './Payment.model';
// ── Associations ──
Application.belongsTo(Student, { foreignKey: 'studentId', as: 'student' });
Student.hasMany(Application, { foreignKey: 'studentId', as: 'applications' });
Enrollment.belongsTo(Student, { foreignKey: 'studentId', as: 'student' });
Student.hasMany(Enrollment, { foreignKey: 'studentId', as: 'enrollments' });
FeePlan.belongsTo(Student, { foreignKey: 'studentId', as: 'student' });
Student.hasMany(FeePlan, { foreignKey: 'studentId', as: 'feePlans' });
Payment.belongsTo(Student, { foreignKey: 'studentId', as: 'student' });
Student.hasMany(Payment, { foreignKey: 'studentId', as: 'payments' });
export { sequelize, User, Notification, Student, Application, Enrollment, FeePlan, Payment };
