    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand — regenerate from the
 * approved WorkflowSpec instead.
 * HTTP handlers for Appointment.
 */
import { Request, Response, NextFunction } from 'express';
import * as svc from '../services/appointment.service';
export const list = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { rows, pagination } = await svc.listAppointment({
      page: Number(req.query.page),
      limit: Number(req.query.limit),
      sort: req.query.sort as string,
      order: req.query.order as string,
    });
    res.json({ success: true, data: { appointments: rows, pagination } });
  } catch (err) { next(err); }
};
export const get = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const appointment = await svc.getAppointment(Number(req.params.id));
    res.json({ success: true, data: { appointment } });
  } catch (err) { next(err); }
};
export const create = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const appointment = await svc.createAppointment(req.body);
    res.status(201).json({ success: true, data: { appointment } });
  } catch (err) { next(err); }
};
export const update = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const appointment = await svc.updateAppointment(Number(req.params.id), req.body);
    res.json({ success: true, data: { appointment } });
  } catch (err) { next(err); }
};
export const remove = async (req: Request, res: Response, next: NextFunction) => {
  try {
    await svc.deleteAppointment(Number(req.params.id));
    res.json({ success: true, data: { deleted: true } });
  } catch (err) { next(err); }
};
export const transition = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const user = (req as any).user as { id: number; role: string };
    const record = await svc.transitionAppointment(Number(req.params.id), String(req.body.to), user);
    res.json({ success: true, data: { appointment: record } });
  } catch (err) { next(err); }
};
