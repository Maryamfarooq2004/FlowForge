 */
import { useEffect, useState } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import { api } from '../../api/client';
import { getEntity, WORKFLOW } from '../../lib/meta';
import { formatValue } from '../../lib/format';
import StateBadge from '../../components/StateBadge';
import { getUser } from '../../auth/session';
const ENTITY = getEntity('fee-plans')!;
export default function FeePlanDetailPage() {
  const navigate = useNavigate();
  const params = useParams();
  const id = params.id;
  const [record, setRecord] = useState<Record<string, any> | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);
  const load = () => {
    if (!id) return;
    api
      .get<Record<string, any>>('/fee-plans/' + id)
      .then((data) => setRecord((Object.values(data)[0] as Record<string, any>) || null))
      .catch((err) => setError(err instanceof Error ? err.message : 'Failed to load'));
  };
  useEffect(load, [id]);
  const doTransition = async (to: string) => {
    setBusy(true);
    try {
      await api.post('/fee-plans/' + id + '/transition', { to });
      load();
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Transition failed');
    } finally {
      setBusy(false);
    }
  };
  if (!record) {
    return <div>{error ? <div className="alert-error">{error}</div> : 'Loading\\u2026'}</div>;
  }
  const role = getUser()?.role;
  const status = String(record.status);
  const available = ENTITY.isWorkflow && WORKFLOW ? WORKFLOW.transitions.filter((t) => t.from === status) : [];
  return (
    <div style={{ maxWidth: 720 }}>
      <div className="row-between">
        <h1>{ENTITY.modelName}</h1>
        <div style={{ display: 'flex', gap: '0.5rem' }}>
          <button className="btn btn-ghost" onClick={() => navigate('/fee-plans')}>Back</button>
          <Link className="btn btn-primary" to={'/fee-plans/' + String(id) + '/edit'}>Edit</Link>
        </div>
      </div>
      {error ? <div className="alert-error">{error}</div> : null}
      <div className="card">
        {ENTITY.fields.map((f) => (
          <div key={f.attrName} className="row-between" style={{ marginBottom: '0.5rem' }}>
            <span className="muted">{f.label}</span>
            <span>{f.isStatus ? <StateBadge label={status} /> : formatValue(f, record[f.attrName])}</span>
          </div>
        ))}
      </div>
      {available.length > 0 ? (
        <div className="card" style={{ marginTop: '1.25rem' }}>
          <h3>Actions</h3>
          <div style={{ display: 'flex', gap: '0.6rem', flexWrap: 'wrap' }}>
            {available.map((t) => {
              const blocked = t.roleKey !== null && t.roleKey !== role;
              return (
                <button
                  key={t.to}
                  className="btn btn-primary"
                  disabled={blocked || busy}
                  title={blocked ? 'Only ' + t.roleKey + ' can do this' : undefined}
                  onClick={() => doTransition(t.to)}
                >
                  {t.label}
                </button>
              );
            })}
          </div>
        </div>
      ) : null}
    </div>
  );
}
