  {
    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand.
 * Landing dashboard: entity counts + workflow tally.
 */
import { useEffect, useState } from 'react';
import { ENTITIES, WORKFLOW } from '../lib/meta';
import { api } from '../api/client';
export default function DashboardPage() {
  const [counts, setCounts] = useState<Record<string, number>>({});
  const [tally, setTally] = useState<Record<string, number>>({});
  useEffect(() => {
    let active = true;
    const run = async () => {
      const next: Record<string, number> = {};
      for (const e of ENTITIES) {
        try {
          const data = await api.get<Record<string, any>>('/' + e.routeBase);
          const rows = (data[e.collectionKey] as Record<string, any>[]) || [];
          next[e.key] = rows.length;
          if (WORKFLOW && e.key === WORKFLOW.entityKey && active) {
            const t: Record<string, number> = {};
            for (const s of WORKFLOW.states) t[s.key] = 0;
            for (const r of rows) {
              const st = String(r[WORKFLOW.statusAttr]);
              t[st] = (t[st] || 0) + 1;
            }
            setTally(t);
          }
        } catch {
          next[e.key] = 0;
        }
      }
      if (active) setCounts(next);
    };
    void run();
    return () => {
      active = false;
    };
  }, []);
  return (
    <div>
      <h1>Dashboard</h1>
      <div className="stat-grid">
        {ENTITIES.map((e) => (
          <div key={e.key} className="card">
            <div className="stat-value">{counts[e.key] ?? 0}</div>
            <div className="muted">{e.label}</div>
          </div>
        ))}
      </div>
      {WORKFLOW ? (
        <div className="card" style={{ marginTop: '1.5rem' }}>
          <h3>Workflow status</h3>
          <div style={{ display: 'flex', gap: '0.75rem', flexWrap: 'wrap' }}>
            {WORKFLOW.states.map((s) => (
              <span key={s.key} className="badge">{s.label}: {tally[s.key] ?? 0}</span>
            ))}
          </div>
        </div>
      ) : null}
    </div>
  );
}
",
    "path": "client/src/pages/DashboardPage.tsx",
  },
  {
    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand.
 * Detail view for Enrollment.
 */
import { useEffect, useState } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import { api } from '../../api/client';
import { getEntity, WORKFLOW } from '../../lib/meta';
import { formatValue } from '../../lib/format';
import StateBadge from '../../components/StateBadge';
import { getUser } from '../../auth/session';
const ENTITY = getEntity('enrollments')!;
export default function EnrollmentDetailPage() {
  const navigate = useNavigate();
  const params = useParams();
  const id = params.id;
  const [record, setRecord] = useState<Record<string, any> | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);
  const load = () => {
    if (!id) return;
    api
      .get<Record<string, any>>('/enrollments/' + id)
      .then((data) => setRecord((Object.values(data)[0] as Record<string, any>) || null))
      .catch((err) => setError(err instanceof Error ? err.message : 'Failed to load'));
  };
  useEffect(load, [id]);
  const doTransition = async (to: string) => {
    setBusy(true);
    try {
      await api.post('/enrollments/' + id + '/transition', { to });
      load();
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Transition failed');
    } finally {
      setBusy(false);
    }
  };
  if (!record) {
    return <div>{error ? <div className="alert-error">{error}</div> : 'Loading\\u2026'}</div>;
  }
  const role = getUser()?.role;
  const status = String(record.status);
  const available = ENTITY.isWorkflow && WORKFLOW ? WORKFLOW.transitions.filter((t) => t.from === status) : [];
  return (
    <div style={{ maxWidth: 720 }}>
      <div className="row-between">
        <h1>{ENTITY.modelName}</h1>
        <div style={{ display: 'flex', gap: '0.5rem' }}>
          <button className="btn btn-ghost" onClick={() => navigate('/enrollments')}>Back</button>
          <Link className="btn btn-primary" to={'/enrollments/' + String(id) + '/edit'}>Edit</Link>
        </div>
      </div>
      {error ? <div className="alert-error">{error}</div> : null}
      <div className="card">
        {ENTITY.fields.map((f) => (
          <div key={f.attrName} className="row-between" style={{ marginBottom: '0.5rem' }}>
