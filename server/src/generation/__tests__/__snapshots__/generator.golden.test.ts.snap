    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand — regenerate from the
 * approved WorkflowSpec instead.
 * Roles & permission matrix (from the WorkflowSpec).
 */
export const ROLE_KEYS = ['admission_officer', 'teacher', 'principal', 'accounts_staff'] as const;
export type RoleKey = typeof ROLE_KEYS[number];
// action -> allowed, per role. Entity CRUD routes are guarded from this matrix
// (see the route files); use can() for finer-grained capability checks.
export const PERMISSION_MATRIX: Record<string, Record<string, boolean>> = {
  "admission_officer": {
    "Register Applications": true,
    "Schedule Tests": true,
    "Record Decisions": true,
    "View Student Records": true,
    "Manage Fees": false
  },
  "teacher": {
    "View Student Records": true,
    "Record Test Scores": true,
    "Record Decisions": false,
    "Manage Fees": false
  },
  "principal": {
    "View Student Records": true,
    "Approve Admissions": true,
    "View Reports": true,
    "Manage Fees": true
  },
  "accounts_staff": {
    "Manage Fees": true,
    "Collect Payments": true,
    "View Student Records": true,
    "Approve Admissions": false
  }
};
/** True if the given role is granted the named capability. */
export const can = (role: string, action: string): boolean =>
  PERMISSION_MATRIX[role]?.[action] === true;
