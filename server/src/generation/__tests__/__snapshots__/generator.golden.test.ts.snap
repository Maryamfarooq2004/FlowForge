  {
    "contents": "/**
 * Auto-generated by FlowForge. Do not edit by hand.
 * Landing dashboard: entity counts + workflow tally.
 */
import { useEffect, useState } from 'react';
import { ENTITIES, WORKFLOW } from '../lib/meta';
import { api } from '../api/client';
export default function DashboardPage() {
  const [counts, setCounts] = useState<Record<string, number>>({});
  const [tally, setTally] = useState<Record<string, number>>({});
  useEffect(() => {
    let active = true;
    const run = async () => {
      const next: Record<string, number> = {};
      for (const e of ENTITIES) {
        try {
          const data = await api.get<Record<string, any>>('/' + e.routeBase);
          const rows = (data[e.collectionKey] as Record<string, any>[]) || [];
          next[e.key] = rows.length;
          if (WORKFLOW && e.key === WORKFLOW.entityKey && active) {
            const t: Record<string, number> = {};
            for (const s of WORKFLOW.states) t[s.key] = 0;
            for (const r of rows) {
              const st = String(r[WORKFLOW.statusAttr]);
              t[st] = (t[st] || 0) + 1;
            }
            setTally(t);
          }
        } catch {
          next[e.key] = 0;
        }
      }
      if (active) setCounts(next);
    };
    void run();
    return () => {
      active = false;
    };
  }, []);
  return (
    <div>
      <h1>Dashboard</h1>
      <div className="stat-grid">
        {ENTITIES.map((e) => (
          <div key={e.key} className="card">
            <div className="stat-value">{counts[e.key] ?? 0}</div>
            <div className="muted">{e.label}</div>
          </div>
        ))}
      </div>
      {WORKFLOW ? (
        <div className="card" style={{ marginTop: '1.5rem' }}>
          <h3>Workflow status</h3>
          <div style={{ display: 'flex', gap: '0.75rem', flexWrap: 'wrap' }}>
            {WORKFLOW.states.map((s) => (
              <span key={s.key} className="badge">{s.label}: {tally[s.key] ?? 0}</span>
            ))}
          </div>
        </div>
      ) : null}
    </div>
  );
}
