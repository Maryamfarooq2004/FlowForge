import { Request, Response, NextFunction } from 'express';
import * as svc from '../services/application.service';
export const list = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { rows, pagination } = await svc.listApplication({
      page: Number(req.query.page),
      limit: Number(req.query.limit),
      sort: req.query.sort as string,
      order: req.query.order as string,
    });
    res.json({ success: true, data: { applications: rows, pagination } });
  } catch (err) { next(err); }
};
export const get = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const application = await svc.getApplication(Number(req.params.id));
    res.json({ success: true, data: { application } });
  } catch (err) { next(err); }
};
export const create = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const application = await svc.createApplication(req.body);
    res.status(201).json({ success: true, data: { application } });
  } catch (err) { next(err); }
};
export const update = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const application = await svc.updateApplication(Number(req.params.id), req.body);
    res.json({ success: true, data: { application } });
  } catch (err) { next(err); }
};
export const remove = async (req: Request, res: Response, next: NextFunction) => {
  try {
    await svc.deleteApplication(Number(req.params.id));
    res.json({ success: true, data: { deleted: true } });
  } catch (err) { next(err); }
};
export const transition = async (req: Request, res: Response, next: NextFunction) => {
  try {
    const user = (req as any).user as { id: number; role: string };
    const record = await svc.transitionApplication(Number(req.params.id), String(req.body.to), user);
    res.json({ success: true, data: { application: record } });
  } catch (err) { next(err); }
};
