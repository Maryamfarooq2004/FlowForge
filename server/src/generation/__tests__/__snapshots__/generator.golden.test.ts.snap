 */
import { Payment } from '../models/Payment.model';
import { AppError } from '../utils/AppError';
// ── Business rules (from the WorkflowSpec) ──
// [FlowForge RULE — NOT AUTO-ENFORCED]: A payment receipt is generated automatically when a payment is marked Paid.
const WRITABLE = ['patientId', 'amount', 'method', 'status', 'date'] as const;
const pick = (data: Record<string, any>): Record<string, any> => {
  const out: Record<string, any> = {};
  for (const key of WRITABLE) {
    if (data[key] !== undefined) out[key] = data[key];
  }
  return out;
};
export interface ListOptions { page?: number; limit?: number; sort?: string; order?: string; }
// Sortable columns are allow-listed: an unvalidated sort column would be
// interpolated straight into ORDER BY.
const SORTABLE: string[] = ['id', 'patientId', 'amount', 'method', 'status', 'date'];
export const listPayment = async (opts: ListOptions = {}) => {
  const page = Math.max(1, Number(opts.page) || 1);
  const limit = Math.min(100, Math.max(1, Number(opts.limit) || 25));
  const sort = SORTABLE.includes(String(opts.sort)) ? String(opts.sort) : 'id';
  const order = String(opts.order).toUpperCase() === 'ASC' ? 'ASC' : 'DESC';
  const { rows, count } = await Payment.findAndCountAll({
    order: [[sort, order]] as any,
    limit,
    offset: (page - 1) * limit,
  });
  return {
    rows,
    pagination: { page, limit, total: count, totalPages: Math.max(1, Math.ceil(count / limit)) },
  };
};
export const getPayment = async (id: number) => {
  const record = await Payment.findByPk(id);
  if (!record) throw new AppError('Payment not found.', 404, 'NOT_FOUND');
  return record;
};
export const createPayment = async (data: Record<string, any>) =>
  Payment.create(pick(data));
export const updatePayment = async (id: number, data: Record<string, any>) => {
  const record = await getPayment(id);
  await record.update(pick(data));
  return record;
};
export const deletePayment = async (id: number) => {
  const record = await getPayment(id);
  await record.destroy();
};
